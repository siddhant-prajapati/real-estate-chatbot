# Git / IDE
.git
.gitignore
.gitattributes
.idea
.vscode
.cursor
.vercel

# Secrets — Compose injects .env at runtime via env_file
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
*.pem
*.key

# Local toolchains (image installs its own)
.venv
venv
env
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.cache
**/huggingface
backend/.cache
node_modules
frontend/node_modules
frontend/dist
frontend/.vite
npm-debug.log*
*.log

# Runtime indexes — image uses packaged seed, then ingest on boot
backend/data/chroma
backend/data/properties.db
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/raw
backend/data/last_live_scrape.json

# Docs and host-only deploy files (not needed inside the Compose image)
README.md
render.yaml
vercel.json
frontend/vercel.json
frontend/.env.example

# Keep seed catalog in the image
!backend/data/seed
!backend/data/seed/**
